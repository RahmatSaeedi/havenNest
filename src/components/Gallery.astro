---
import type { Photo } from '../data/photos';

interface Props {
  items: Photo[];
  group: string;
  /** Optional cap on how many tiles to show in the grid (lightbox still loops all). */
  limit?: number;
  /** Show a "1 / N" badge on the first tile. */
  showCount?: boolean;
  class?: string;
}

const { items, group, limit, showCount = true, class: className = '' } = Astro.props;
const shown = limit ? items.slice(0, limit) : items;
const total = items.length;
---

<div class:list={['gallery', className]} data-gallery-grid>
  {
    shown.map((p, i) => (
      <a
        class="glightbox gallery__item"
        href={p.full}
        data-gallery={group}
        data-glightbox={`description: ${p.alt}`}
        aria-label={p.alt}
        style={`aspect-ratio: ${p.w} / ${p.h};`}
      >
        <img
          src={p.thumb}
          alt={p.alt}
          width={p.w}
          height={p.h}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
        {showCount && i === 0 && total > 1 && (
          <span class="gallery__count">1 / {total}</span>
        )}
        <span class="gallery__zoom" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
            <line x1="11" y1="8" x2="11" y2="14" />
            <line x1="8" y1="11" x2="14" y2="11" />
          </svg>
        </span>
      </a>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 920px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gallery__item {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--r);
    background: var(--surface-3);
    box-shadow: var(--shadow-1);
    aspect-ratio: 4 / 3;
  }
  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow) var(--ease);
  }
  .gallery__item:hover img {
    transform: scale(1.04);
  }
  .gallery__count {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--r-pill);
    background: rgba(28, 27, 24, 0.72);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 600;
    backdrop-filter: blur(4px);
  }
  .gallery__zoom {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--ink);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--t) var(--ease), transform var(--t) var(--ease);
  }
  .gallery__item:hover .gallery__zoom,
  .gallery__item:focus-visible .gallery__zoom {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import '../scripts/lightbox';
</script>
