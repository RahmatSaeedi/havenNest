---
import { site } from '../data/site';
const year = 2026; // build year; update via CI if desired
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.property.mapsQuery)}`;

const socialIcons: Record<string, string> = {
  facebook: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  instagram: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5zM17.5 6a1 1 0 1 1-1 1 1 1 0 0 1 1-1z',
  x: 'M18.9 2H22l-7.5 8.6L23 22h-6.8l-5.3-7-6.1 7H1.6l8-9.2L1 2h7l4.8 6.4zM16.8 20h1.9L7.3 4H5.3z',
  linkedin: 'M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1A4.2 4.2 0 0 1 16.6 9c4 0 4.4 2.4 4.4 5.6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21H9z',
};
const socials = Object.entries(site.social)
  .filter(([k, v]) => v && socialIcons[k])
  .map(([k, v]) => ({ name: k, href: v as string, icon: socialIcons[k] }));
---

<footer class="site-footer section--dark">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img
        src="/images/logo-mark-light.png"
        alt={site.legalName}
        width="56"
        height="56"
        class="site-footer__mark"
        loading="lazy"
      />
      <p class="site-footer__name gold-text">{site.legalName}</p>
      <p class="site-footer__tag">{site.tagline}</p>
      <p class="site-footer__pitch">{site.shortPitch}</p>
      {socials.length > 0 && (
        <ul class="site-footer__social" aria-label="Social media">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.name}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav class="site-footer__col" aria-label="Footer — Explore">
      <h2 class="site-footer__h">Explore</h2>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/properties">Available Units</a></li>
        <li><a href="/builder">Our Builds</a></li>
        <li><a href="/apply">Apply to Rent</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__h">Visit</h2>
      <ul>
        <li>
          <a href={mapsUrl} target="_blank" rel="noopener">
            {site.property.addressLine}<br />
            {site.property.city}, {site.property.province}
          </a>
        </li>
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        {site.contact.phone && (
          <li><a href={`tel:${site.contact.phone.replace(/\D/g, '')}`}>{site.contact.phone}</a></li>
        )}
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__h">Legal</h2>
      <ul>
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
      <p class="site-footer__note">
        HavenNest does not charge a rental application fee. Applications are
        reviewed using consistent criteria for every applicant.
      </p>
    </div>
  </div>

  <div class="container site-footer__bar">
    <p>© {site.copyrightStartYear}–{year} {site.legalName}. All rights reserved.</p>
    <p>Built in Edmonton, Alberta.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: clamp(3rem, 6vw, 4.5rem) 0;
  }
  .site-footer__inner {
    display: grid;
    gap: var(--s-6);
    grid-template-columns: 1fr;
  }
  .site-footer__mark {
    height: 56px;
    width: auto;
    margin-bottom: 0.75rem;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
  }
  .site-footer__tag {
    color: var(--gold-bright);
    font-size: var(--fs-sm);
    font-style: italic;
    margin-top: 0.15rem;
  }
  .site-footer__pitch {
    color: var(--on-dark-muted);
    font-size: var(--fs-sm);
    max-width: 34ch;
    margin-top: 0.9rem;
  }
  .site-footer__social {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
  }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--on-dark-line);
    color: var(--on-dark);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .site-footer__social a:hover {
    color: var(--gold-bright);
    border-color: var(--gold-bright);
  }
  .site-footer__h {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
    margin-bottom: 0.9rem;
  }
  .site-footer__col ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .site-footer__col a {
    color: var(--on-dark);
    font-size: var(--fs-sm);
  }
  .site-footer__col a:hover {
    color: var(--gold-bright);
  }
  .site-footer__note {
    margin-top: 1.1rem;
    color: var(--on-dark-muted);
    font-size: var(--fs-xs);
    max-width: 30ch;
  }
  .site-footer__bar {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--on-dark-line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    color: var(--on-dark-muted);
    font-size: var(--fs-xs);
  }
  @media (min-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
      gap: var(--s-7);
    }
  }
</style>
