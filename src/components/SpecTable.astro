---
interface Row {
  label: string;
  value: string;
}
interface Props {
  rows: Row[];
  caption?: string;
}
const { rows, caption } = Astro.props;
---

<dl class="spec" aria-label={caption ?? 'Specifications'}>
  {
    rows.map((r) => (
      <div class="spec__row">
        <dt>{r.label}</dt>
        <dd>{r.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .spec {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
    background: var(--surface);
  }
  .spec__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .spec__row:last-child {
    border-bottom: 0;
  }
  .spec dt {
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .spec dd {
    margin: 0;
    text-align: right;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
</style>
