---
import { getCollection, render } from 'astro:content';
import sanitizeHtml from 'sanitize-html';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import SpecTable from '../../components/SpecTable.astro';
import Share from '../../components/Share.astro';
import { getSet, getCover } from '../../data/photos';
import { site } from '../../data/site';
import { money, bathLabel, num } from '../../lib/format';

export async function getStaticPaths() {
  const properties = await getCollection('properties');
  return properties.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const photos = getSet(d.gallery);
const cover = getCover(d.gallery, d.coverIndex);

const statusMap = {
  available: { label: 'Available now', cls: 'pill--ok' },
  pending: { label: 'Application pending', cls: 'pill--warn' },
  rented: { label: 'Rented', cls: 'pill--muted' },
} as const;
const status = statusMap[d.status];

const specRows = [
  { label: 'Suite type', value: d.unitType === 'main' ? 'Main-floor suite' : 'Legal basement suite' },
  { label: 'Bedrooms', value: String(d.beds) },
  { label: 'Bathrooms', value: bathLabel(d.baths) },
  { label: 'Size', value: `${num(d.sqft)} sq ft` },
  { label: 'Monthly rent', value: money(d.rent) },
  { label: 'Utilities', value: d.utilitiesNote },
  { label: 'Parking', value: 'Free street parking' },
  { label: 'Garage', value: d.garageAvailable ? `${money(d.garagePrice)}/mo detached (optional)` : 'Not available' },
  { label: 'Availability', value: d.availableFrom },
];

const safeCustomHtml = d.customHtml
  ? sanitizeHtml(d.customHtml, {
      allowedTags: [
        ...sanitizeHtml.defaults.allowedTags,
        'img', 'figure', 'figcaption', 'h1', 'h2', 'section', 'span', 'hr',
      ],
      allowedAttributes: {
        '*': ['style', 'class', 'id'],
        a: ['href', 'name', 'target', 'rel'],
        img: ['src', 'alt', 'title', 'width', 'height', 'loading'],
      },
      allowedSchemesByTag: { img: ['https', 'data'], a: ['https', 'mailto', 'tel'] },
    })
  : null;

const others = (await getCollection('properties'))
  .filter((p) => p.id !== entry.id && p.data.status === 'available')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.property.mapsQuery)}`;
const ogImg = cover?.full ?? '/images/og-image.jpg';

const listingLd = {
  '@context': 'https://schema.org',
  '@type': 'Apartment',
  name: d.title,
  numberOfBedrooms: d.beds,
  numberOfBathroomsTotal: d.baths,
  floorSize: { '@type': 'QuantitativeValue', value: d.sqft, unitCode: 'FTK' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.property.addressLine,
    addressLocality: site.property.city,
    addressRegion: site.property.province,
    addressCountry: 'CA',
  },
};
---

<Base title={d.title} description={d.summary ?? d.title} image={ogImg}>
  <div class="container listing">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/properties">← All available units</a>
    </nav>

    <header class="listing__head">
      <div>
        <span class:list={['pill', status.cls]}><span class="pill__dot"></span>{status.label}</span>
        <h1>{d.title}</h1>
        <p class="listing__addr">
          <a href={mapsUrl} target="_blank" rel="noopener">
            {site.property.addressLine}, {site.property.city}, {site.property.province}
          </a>
        </p>
      </div>
    </header>

    {photos.length > 0 && <Gallery items={photos} group={`unit-${entry.id}`} class="listing__gallery" />}

    <div class="listing__grid">
      <div class="listing__main">
        <div class="prose">
          <Content />
        </div>

        <h2 class="listing__h">What's included</h2>
        <ul class="featurelist">
          {d.features.map((f) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {f}
            </li>
          ))}
        </ul>

        <h2 class="listing__h">Appliances (all brand new)</h2>
        <ul class="featurelist">
          {d.appliances.map((a) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {a}
            </li>
          ))}
        </ul>

        {safeCustomHtml && <div class="custom-html" set:html={safeCustomHtml} />}
      </div>

      <aside class="listing__aside">
        <div class="bookcard card">
          <p class="bookcard__rent"><span>{money(d.rent)}</span>/mo</p>
          <p class="bookcard__note">{d.utilitiesNote}</p>
          <ul class="bookcard__specs">
            <li><strong>{d.beds}</strong> bed</li>
            <li><strong>{bathLabel(d.baths)}</strong> bath</li>
            <li><strong>{num(d.sqft)}</strong> sq ft</li>
          </ul>
          {
            d.status === 'available' ? (
              <a class="btn btn--primary btn--lg btn--block" href={`/apply?unit=${entry.id}`}>
                Apply for this unit
              </a>
            ) : (
              <a class="btn btn--secondary btn--lg btn--block" href="/contact">
                Join the waitlist
              </a>
            )
          }
          <a class="bookcard__contact" href="/contact">Have a question? Contact us</a>
        </div>

        <div class="spec-wrap">
          <SpecTable rows={specRows} caption={`${d.title} specifications`} />
        </div>

        <div class="listing__share">
          <Share title={`${d.title} — HavenNest`} label="Share this unit" />
        </div>
      </aside>
    </div>

    {
      others.length > 0 && (
        <section class="listing__others">
          <h2 class="listing__h">Other available units</h2>
          <ul class="others">
            {others.map((o) => {
              const oc = getCover(o.data.gallery, o.data.coverIndex);
              return (
                <li>
                  <a href={`/properties/${o.id}`} class="others__card">
                    {oc && <img src={oc.thumb} alt={o.data.title} width={oc.w} height={oc.h} loading="lazy" />}
                    <span class="others__body">
                      <strong>{o.data.title}</strong>
                      <span>{o.data.beds} bed · {bathLabel(o.data.baths)} bath · {money(o.data.rent)}/mo</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(listingLd)} />
</Base>

<style>
  .listing {
    padding-block: var(--s-5) var(--s-8);
  }
  .crumbs {
    padding-block: 0.5rem 1rem;
  }
  .crumbs a {
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .listing__head {
    margin-bottom: var(--s-5);
  }
  .listing__head h1 {
    margin-top: 0.5rem;
  }
  .listing__addr {
    margin-top: 0.4rem;
    color: var(--ink-2);
  }
  .listing__gallery {
    margin-bottom: var(--s-6);
  }
  .listing__grid {
    display: grid;
    gap: var(--s-6);
    align-items: start;
  }
  @media (min-width: 920px) {
    .listing__grid {
      grid-template-columns: 1fr 360px;
      gap: var(--s-7);
    }
  }
  .listing__h {
    font-size: var(--fs-h3);
    margin: var(--s-6) 0 var(--s-4);
  }
  .featurelist {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 560px) {
    .featurelist {
      grid-template-columns: 1fr 1fr;
    }
  }
  .featurelist li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--ink-2);
  }
  .featurelist svg {
    color: var(--gold-deep);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .custom-html {
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .custom-html :global(img) {
    border-radius: var(--r);
  }

  .listing__aside {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .bookcard {
    padding: 1.4rem;
  }
  .bookcard__rent {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .bookcard__rent span {
    color: var(--ink);
    font-size: 2.2rem;
    font-weight: 600;
  }
  .bookcard__note {
    color: var(--muted);
    font-size: var(--fs-sm);
    margin-bottom: 0.9rem;
  }
  .bookcard__specs {
    display: flex;
    gap: 1.2rem;
    list-style: none;
    padding: 0.9rem 0;
    margin: 0 0 1rem;
    border-block: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .bookcard__specs strong {
    color: var(--ink);
  }
  .bookcard__contact {
    display: block;
    text-align: center;
    margin-top: 0.85rem;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .others {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: 1fr;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 700px) {
    .others {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .others__card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
    background: var(--surface);
    color: var(--ink);
    transition: box-shadow var(--t) var(--ease), transform var(--t) var(--ease);
  }
  .others__card:hover {
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }
  .others__card img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }
  .others__body {
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .others__body span {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .listing__others {
    margin-top: var(--s-8);
  }
  .listing__share {
    padding: 0.25rem 0.25rem 0;
  }
</style>
